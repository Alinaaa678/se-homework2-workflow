{
  "name": "code-review-workflow-parallel-verified",
  "description": "规格 → 编码 → 并行双路审查 → 独立验收 → 证据判定 → 有界修复",
  "start": "spec",
  "nodes": [
    {
      "id": "spec",
      "agent": "spec",
      "input": {"requirement": "requirement"},
      "output": "spec"
    },
    {
      "id": "coder",
      "agent": "coder",
      "input": {"requirement": "requirement", "spec": "spec"},
      "output": "code"
    },
    {
      "id": "reviews",
      "type": "parallel",
      "tasks": [
        {
          "id": "correctness",
          "agent": "reviewer_correctness",
          "input": {"code": "code", "requirement": "requirement", "spec": "spec"},
          "output": "review_correctness"
        },
        {
          "id": "style",
          "agent": "reviewer_style",
          "input": {"code": "code", "spec": "spec"},
          "output": "review_style"
        }
      ],
      "reduce": "merge_reviews",
      "output": "review"
    },
    {
      "id": "acceptance",
      "agent": "acceptance",
      "input": {"code": "code", "requirement": "requirement", "spec": "spec"},
      "output": "acceptance"
    },
    {
      "id": "verdict",
      "agent": "verdict",
      "input": {"code": "code", "review": "review", "acceptance": "acceptance", "spec": "spec"},
      "output": "verdict"
    },
    {
      "id": "fixer",
      "agent": "fixer",
      "input": {"code": "code", "review": "review", "acceptance": "acceptance", "requirement": "requirement", "spec": "spec"},
      "output": "code"
    }
  ],
  "edges": [
    {"from": "spec", "to": "coder"},
    {"from": "coder", "to": "reviews"},
    {"from": "reviews", "to": "acceptance"},
    {"from": "acceptance", "to": "verdict"},
    {"from": "verdict", "to": "END", "when": "state['verdict']['passed']"},
    {"from": "verdict", "to": "fixer", "when": "not state['verdict']['passed']"},
    {"from": "fixer", "to": "reviews"}
  ]
}
